{
    "name": "mj-zana/skeleton-api",
    "description": "A starting point for a Zana JSON API: modules, bearer tokens, problem JSON errors, a database, and instructions for AI coding agents",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "zana",
        "skeleton",
        "api"
    ],
    "require": {
        "php": "^8.5",
        "ext-pdo_sqlite": "*",
        "mj-zana/cache": "^2.10",
        "mj-zana/console": "^2.10",
        "mj-zana/core": "^2.10",
        "mj-zana/database": "^2.10",
        "mj-zana/ddd": "^2.10",
        "mj-zana/http": "^2.10",
        "mj-zana/logging": "^2.10",
        "mj-zana/mediator": "^2.10",
        "mj-zana/routing": "^2.10",
        "mj-zana/security": "^2.10",
        "mj-zana/serialization": "^2.10",
        "mj-zana/validation": "^2.10"
    },
    "require-dev": {
        "mj-zana/maker": "^2.10",
        "mj-zana/testing": "^2.10",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-zip": "Needed by release:build to write the upload archives"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || file_put_contents('.env', str_replace('APP_SECURITY__SECRET=', 'APP_SECURITY__SECRET=' . bin2hex(random_bytes(32)), file_get_contents('.env.example')));\""
        ],
        "serve": "@php -S localhost:8000 -t public",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
